{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "course_title": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "verification": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "review_note": {
      "type": "string"
    }
  },
  "required": [
    "course_title",
    "provider",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}