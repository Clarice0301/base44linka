{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "account_type": {
      "type": "string",
      "description": "Tipo de conta: candidato ou empresa",
      "enum": [
        "candidato",
        "empresa"
      ],
      "enumColors": [
        "teal",
        "blue"
      ],
      "default": "candidato"
    }
  },
  "required": [
    "role"
  ]
}